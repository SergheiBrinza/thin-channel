# Project-specific: external dataset must not be redistributed (Variant B)
# Anyone reproducing the experiment downloads ForecastBench themselves —
# see DATA.md.

# Raw ForecastBench dump (folder layout from `hf download …`)
forecastbench_raw/
*.parquet

# Derived ForecastBench artifacts (contain question text and resolved
# outcomes — these are CC BY-SA 4.0 content from ForecastBench, not ours)
exp6-forecast-calibration/forecastbench_normalized.json
exp6-forecast-calibration/forecastbench_clean.json
exp6-forecast-calibration/questions_with_topics.json

# Our model outputs that embed question text + outcomes — regenerate by
# running gen_raw_predictions.py / pilot_baseline.py after downloading data
exp6-forecast-calibration/raw_predictions.json
exp6-forecast-calibration/pilot_baseline.json

# Full per-question-row dumps from baselines / calibration.
# Aggregate summaries (wide_baseline_summary.json, calibration_summary.json)
# are committed; the full versions stay local.
exp6-forecast-calibration/wide_baseline.json
exp6-forecast-calibration/calibration_results.json
